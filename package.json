{
  "scripts": {
    "build": "esbuild --sourcemap --platform=node --packages=external --bundle --outfile=./build/main.js ./src/main.ts",
    "dev": "esbuild --sourcemap --platform=node --packages=external --bundle --watch --outfile=./build/main.js ./src/main.ts",
    "start": "node --enable-source-maps ./build/main.js"
  },
  "dependencies": {
    "@google/genai": "^0.4.0",
    "discord.js": "^14.18.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
